{
  "name": "react-native-bundle-discovery-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "yarn workspaces foreach -Apt --topological-dev run build",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "dev:ui": "yarn workspace react-native-bundle-discovery-ui run dev",
    "changeset": "changeset",
    "version-packages": "changeset version && yarn install --mode=update-lockfile",
    "release": "yarn build && changeset publish",
    "website:dev": "yarn workspace react-native-bundle-discovery-website run dev",
    "website:build": "yarn workspace react-native-bundle-discovery-website run build:website",
    "examples:build-ios": "bash -c 'for d in examples/*/; do echo \"▶ $d\" && (cd \"$d\" && yarn build-ios) || exit 1; done'",
    "examples:discovery": "bash -c 'trap \"kill 0\" EXIT; for d in examples/*/; do (cd \"$d\" && yarn discovery) & done; wait'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
