{
  "name": "react-native-bundle-discovery",
  "version": "2.10.0",
  "description": "Metro serializer, Webpack/Rspack and Rollipop plugins that generate a JSON report of your React Native bundle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retyui/react-native-bundle-discovery.git",
    "directory": "packages/serializer"
  },
  "author": "David <4661784+retyui@users.noreply.github.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run -T tsdown && run -T prettier --write --log-level warn --ignore-path= \"dist/**/*.js\"",
    "typecheck": "run -T tsc -p tsconfig.json",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "chalk": "^4.1.2"
  },
  "peerDependencies": {
    "metro": "*",
    "rollipop": "*"
  },
  "peerDependenciesMeta": {
    "metro": {
      "optional": true
    },
    "rollipop": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
